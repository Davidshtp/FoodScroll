# ============================================================
# FoodScroll - Docker Environment Template
# Copy to .env.development or .env.production and fill in
# ============================================================

# ───── MySQL (Database Server) ─────
MYSQL_EXTERNAL_PORT=3306
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_USER=feedgo
MYSQL_PASSWORD=change_this_feedgo_password

# ───── PostgreSQL (Database Server) ─────
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password

# ───── MongoDB (Database Server) ─────
MONGODB_EXTERNAL_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_this_mongo_password

# ───── Neo4j (Graph Database) ─────
NEO4J_EXTERNAL_BOLT=7687
NEO4J_EXTERNAL_HTTP=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_neo4j_password
NEO4J_PAGECACHE=512M
NEO4J_HEAP=1024M

# ───── Redis (Cache) ─────
REDIS_EXTERNAL_PORT=6379
REDIS_PASSWORD=change_this_redis_password

# ───── Nginx ─────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ───── Service Auth ─────
JWT_SECRET_KEY=change_this_jwt_secret_at_least_32_chars
SERVICE_SECRET=change_this_service_secret_at_least_32_char

# ───── Microservices Common ─────
JWT_SECRET_KEY=change_this_jwt_secret
SERVICE_SECRET=change_this_service_secret
