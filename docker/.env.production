# ============================================================
# FoodScroll - Production Environment
# WARNING: Fill ALL values with secure credentials
# NEVER commit this file to version control
# ============================================================

# ───── MySQL ─────
MYSQL_EXTERNAL_PORT=3306
MYSQL_ROOT_PASSWORD=__CHANGE_ME_SECURE_ROOT_PASSWORD__
MYSQL_USER=feedgo
MYSQL_PASSWORD=__CHANGE_ME_SECURE_FEEDGO_PASSWORD__

# ───── PostgreSQL ─────
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__CHANGE_ME_SECURE_POSTGRES_PASSWORD__

# ───── MongoDB ─────
MONGODB_EXTERNAL_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=__CHANGE_ME_SECURE_MONGO_PASSWORD__

# ───── Neo4j ─────
NEO4J_EXTERNAL_BOLT=7687
NEO4J_EXTERNAL_HTTP=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=__CHANGE_ME_SECURE_NEO4J_PASSWORD__
NEO4J_PAGECACHE=1G
NEO4J_HEAP=2G

# ───── Redis ─────
REDIS_EXTERNAL_PORT=6379
REDIS_PASSWORD=__CHANGE_ME_SECURE_REDIS_PASSWORD__

# ───── Nginx ─────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
