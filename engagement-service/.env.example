# SERVER PORT
SERVER_PORT=5566

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7697
NEO4J_USER=neo4j
NEO4J_PASSWORD="your-neo4j-password"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MongoDB (using same instance as publications-service but a separate DB)
DATABASE_HOST="localhost"
DATABASE_PORT="27017"
DATABASE_USER=""
DATABASE_PASSWORD=""
DATABASE_NAME="engagement-service"

# JWT secret used by all services
JWT_SECRET_KEY="your-jwt-secret-key-at-least-32-chars-long"

# Service to service authentication (use any secure password, must match gateway)
SERVICE_SECRET="your-secure-service-secret-at-least-32-chars"
