# ───── Gateway ─────
GATEWAY_PORT="3000"

# ───── JWT ─────
JWT_SECRET_KEY="your-jwt-secret-key"

# ───── Service-to-Service Auth (use any secure password) ─────
SERVICE_SECRET="your-secure-service-secret"

# ───── Microservice URLs ─────
IDENTITY_SERVICE_URL="http://127.0.0.1:5560"
CUSTOMER_SERVICE_URL="http://127.0.0.1:5561"
LOCATION_SERVICE_URL="http://127.0.0.1:5562"
DELIVERY_SERVICE_URL="http://127.0.0.1:5563"
RESTAURANT_SERVICE_URL="http://127.0.0.1:5564"
PUBLICATIONS_SERVICE_URL="http://127.0.0.1:5565"
ENGAGEMENT_SERVICE_URL="http://127.0.0.1:5566"
ORDERS_SERVICE_URL="http://127.0.0.1:5567"

# ───── HTTP Client ─────
HTTP_TIMEOUT="10000"
HTTP_RETRIES="2"
