# SERVER CONFIGURATION
SERVER_PORT=5562

# DATABASE CONFIGURATION
DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_USER="root"
DATABASE_PASSWORD="your-db-password"
