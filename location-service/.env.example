# SERVICE-TO-SERVICE AUTH (use any secure password, must match gateway)
SERVICE_SECRET="your-secure-service-secret"

# EXTERNAL APIs
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org/reverse"
