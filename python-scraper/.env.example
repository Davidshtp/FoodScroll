SERVER_PORT=5591
RUNT_URL="https://portalpublico.runt.gov.co/#/consulta-vehiculo/consulta/consulta-ciudadana"

# Service to service authentication (use any secure password, must match gateway)
SERVICE_SECRET="your-secure-service-secret-at-least-32-chars"

JWT_SECRET_KEY="your-jwt-secret-key-at-least-32-chars-long"
PLAYWRIGHT_HEADLESS=true
PAGE_POOL_MIN=1
CIRCUIT_BREAKER_MAX_FAILS=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30
CIRCUIT_BREAKER_RECOVER_SECONDS=60
